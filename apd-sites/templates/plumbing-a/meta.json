        "services": [
            {
                "title": "Emergency Leak Repair",
                "text": "Fast response to stop water damage and restore your plumbing. We locate the source, fix it permanently, and dry affected areas. Available 24/7 for burst pipes, slab leaks, and fixture failures.",
                "image": "images/plumber_fixing_leaking_pipe_un_92bad06bba11066418727b01485e3.webp"
            },
            {
                "title": "Drain Cleaning and Unclogging",
                "text": "Powerful hydro jetting and snaking to clear stubborn blockages in sinks, toilets, and main lines. We remove grease, roots, and debris without damaging pipes, restoring fast drainage and preventing future backups.",
                "image": "images/professional_drain_cleaning_ma_9d652066f645410738c11e0cd24d7.webp"
            },
            {
                "title": "Water Heater Installation & Repair",
                "text": "Expert installation of tank and tankless water heaters, plus repairs and maintenance to extend unit life. We help you choose the right size and energy source for your home, ensuring reliable hot water and lower bills.",
                "image": "images/new_energy_efficient_tankless_e2ae52204ffe95fe784b1cb4129af5.webp"
            }
        ],
        "why_us": [
            {
                "title": "Prevent Costly Water Leaks",
                "text": "Undetected leaks can waste thousands of gallons and damage your foundation. Our advanced leak detection uses thermal imaging and acoustic sensors to locate hidden leaks without tearing up floors. Schedule an annual inspection to catch issues before they become emergencies and keep your water bill under control.",
                "image": "images/plumber_using_thermal_imaging_aa96e88795e3ed6544f20a9b831d38.webp"
            },
            {
                "title": "Upgrade to Efficient Fixtures",
                "text": "Replacing old toilets, faucets, and showerheads with WaterSense-certified models can cut water usage by 30% and reduce utility bills. Our team helps you choose the right styles and handles installation with minimal disruption, ensuring proper seals and flow rates for peak performance and comfort.",
                "image": "images/modern_bathroom_with_new_water_8d67b225bd2765bb4460eb3af9791.webp"
            },
            {
                "title": "Maintain Your Water Heater",
                "text": "Flushing your water heater annually removes sediment that causes corrosion and inefficiency. We inspect the anode rod, pressure relief valve, and thermostat, extending the unit's lifespan by years. Signs you need service include rumbling noises, rusty water, or inconsistent hot water\u2014don't wait for a cold shower.",
                "image": "images/plumber_performing_maintenance_7fe4c841262cb9fe877d567620a1e.webp"
            }
        ]
    }
